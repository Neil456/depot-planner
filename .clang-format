# Google style with a slightly wider column limit, matching the Python side's
# 100-character convention.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++17
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Preserve
AllowShortFunctionsOnASingleLine: Inline
